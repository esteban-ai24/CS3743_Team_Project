-- Update:
-- Should enforce the rule that product prices do not change.
-- Input is OLD and NEW product records, and output is a message that's returned when a product price is rejected because it's trying to be changed/updated (when OLD != NEW).

DELIMITER //

CREATE TRIGGER trg_price_update
  BEFORE UPDATE ON products
  FOR EACH ROW
BEGIN
  IF NOT (NEW.prod_price <=> OLD.prod_price) THEN
    SIGNAL SQLSTATE '45000'
    SET MESSAGE_TEXT = 'Product prices cannot be changes.';
  END IF;
END //

DELIMITER ;

